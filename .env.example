DATABASE_URL="postgresql://user:password@localhost:5432/certifychain"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
APP_BASE_URL="http://localhost:3000"

# Blockchain — see onchain/ for the smart contract project.
# RPC_URL: JSON-RPC endpoint of the target network (local Hardhat node,
#   or a provider URL like Infura/Alchemy for a public testnet).
# PRIVATE_KEY: the wallet that signs issueCertificate/revokeCertificate
#   transactions. NEVER commit a real private key — for local development,
#   use one of the well-known test-account keys printed by `npx hardhat node`.
# CONTRACT_ADDRESS: printed by `npm run deploy:localhost` in onchain/.
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_PRIVATE_KEY=""
BLOCKCHAIN_CONTRACT_ADDRESS=""

# Email delivery — see "Email Setup" in README.md. Two options; if SMTP_USER and
# SMTP_PASS are set, SMTP is used, otherwise Resend.
#
# Option A: SMTP, e.g. Gmail. Can email any recipient with no domain needed.
# SMTP_USER: your Gmail address. SMTP_PASS: a Google *App Password* (16 letters;
#   needs 2-Step Verification on; NOT your normal password).
# SMTP_HOST / SMTP_PORT / SMTP_FROM are optional (default smtp.gmail.com / 465 /
#   "Certi <SMTP_USER>").
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_FROM=""
#
# Option B: Resend.
# RESEND_API_KEY: server-side only, from the Resend dashboard (API Keys).
# RESEND_FROM_EMAIL: the sender, e.g. "Certi <certificates@your-verified-domain.com>".
#   Resend's shared test sender (onboarding@resend.dev) can only deliver to the
#   email address your Resend account was registered with.
# The verification link in each email uses APP_BASE_URL above, so set it to the
# public URL of the app (not localhost) when deployed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
